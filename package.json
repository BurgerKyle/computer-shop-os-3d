{
  "name": "computer-shop-os-3d",
  "version": "1.0.1",
  "description": "3D Three.js Sky Island Hub and Character Creator for Computer Shop OS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "vite": "vite --host --port 5174",
    "serve": "node server.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/smoke-check.js && npm test",
    "lint": "node scripts/smoke-check.js",
    "e2e": "node scripts/e2e-smoke.js",
    "e2e:install": "npx playwright install chromium"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "three": "^0.160.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "vite": "^6.0.0"
  }
}
